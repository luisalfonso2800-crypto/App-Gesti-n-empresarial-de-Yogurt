{
  "name": "desktop",
  "version": "1.0.0",
  "description": "Sistema de Gestión Empresarial MANNÁ",
  "author": "Lácteos MANNÁ",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win -c.npmRebuild=false"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.manna.yogurtmanagement",
    "productName": "MANNÁ Gestión Empresarial",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
